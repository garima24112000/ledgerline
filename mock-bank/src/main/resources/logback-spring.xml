<?xml version="1.0" encoding="UTF-8"?>
<!--
  One JSON object per log line on stdout. Every MDC entry becomes a top-level field: traceId and spanId
  (Micrometer Tracing, for HTTP requests), plus paymentId / eventId where the code sets them.
  The same file is copied into each app; run with the "plain-logs" profile for Boot's usual text format.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <!-- Context properties are written into every JSON line, so each line names its app. -->
    <springProperty scope="context" name="app" source="spring.application.name"/>

    <springProfile name="plain-logs">
        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!plain-logs">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
